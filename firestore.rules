rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'b4fw5YcvyhPaVA5sEJlqGypZoS32';
    }

    // Legacy fitness tracker docs, if any remain.
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'b4fw5YcvyhPaVA5sEJlqGypZoS32';
    }
  }
}
